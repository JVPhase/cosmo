# Copy this file to .env.prod before the first production deploy.
# Run production with:
#   docker compose --env-file .env.prod -f compose.prod.yml up -d --build

API_DOMAIN=localhost:3000
APP_ORIGIN=http://localhost:8080

POSTGRES_DB=cosmo_db
POSTGRES_USER=cosmo
POSTGRES_PASSWORD=replace_with_a_strong_password

JWT_SECRET=replace_with_a_long_random_string
TELEGRAM_BOT_TOKEN=1234567890:replace_with_real_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret

MONETIZATION_ENABLED=true

# Optional OAuth config.
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=

# Optional CRM bootstrap admin. If both values are set, `npm run db:seed`
# will create/update this user and assign the CRM role `admin`.
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=replace_with_a_strong_password

# Optional admin/auth config.
# Add extra frontend origins here, for example a standalone CRM on Cloudflare Pages.
# CORS_ALLOWED_ORIGINS=https://crm.example.com,https://staging-crm.example.com
# METRICS_ADMIN_TOKEN=replace_with_random_token

# Optional feature flags.
# SAVE_V2_ENABLED=false
# GRANT_SYNC_ENABLED=false
# TELEGRAM_SHOP_SYNC_ONLY=false
