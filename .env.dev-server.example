# Local development server stack.
# Start with:
#   docker compose --env-file .env.dev-server -f compose.dev-server.yml up -d --build

SERVER_PORT=3002
POSTGRES_PORT=5433

POSTGRES_DB=cosmo_dev
POSTGRES_USER=cosmo
POSTGRES_PASSWORD=cosmo_dev_password

APP_ORIGIN=http://localhost:8080,http://localhost:8081
JWT_SECRET=cosmo-local-dev-change-me
TELEGRAM_BOT_TOKEN=1234567890:dev-token
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
MONETIZATION_ENABLED=true

# Optional OAuth config.
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=

# Optional CRM bootstrap admin.
# CRM_ADMIN_EMAIL=admin@example.com
# CRM_ADMIN_PASSWORD=dev-admin-password

# Optional CORS / admin config.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# METRICS_ADMIN_TOKEN=dev-metrics-token

# Optional feature flags.
# SAVE_V2_ENABLED=false
# GRANT_SYNC_ENABLED=false
# TELEGRAM_SHOP_SYNC_ONLY=false
# TELEGRAM_SUMMARY_CANONICAL=false
# DOMAIN_CANONICAL_ENABLED=true
# WALLET_ENABLED=false
