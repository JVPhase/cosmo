# Local test environment on the same public ports as production.
# Start with:
#   docker compose --env-file .env.test-local -f compose.test-local.yml up -d --build

API_DOMAIN=localhost
APP_ORIGIN=http://localhost

POSTGRES_DB=cosmo_test_local
POSTGRES_USER=cosmo
POSTGRES_PASSWORD=cosmo_test_local_password

JWT_SECRET=cosmo-test-local-change-me
TELEGRAM_BOT_TOKEN=1234567890:test-local-token
TELEGRAM_WEBHOOK_SECRET=test-local-webhook-secret

MONETIZATION_ENABLED=true

# Optional OAuth config.
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=

# Optional CRM bootstrap admin.
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=test-admin-password

# Optional admin/auth config.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
# METRICS_ADMIN_TOKEN=test-local-metrics-token

# Optional feature flags.
# SAVE_V2_ENABLED=false
# GRANT_SYNC_ENABLED=false
# TELEGRAM_SHOP_SYNC_ONLY=false
