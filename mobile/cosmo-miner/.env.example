# Копируй в .env и запусти в отдельном терминале: yarn analytics-sink
# Файл на диске ПК: dev-logs/cosmo_analytics.ndjson

# PostHog — аналитика (https://posthog.com → Project Settings → Project API Key)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EU-кластер: https://eu.i.posthog.com  |  US-кластер: https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# iOS Simulator, Expo web на этом же ПК:
EXPO_PUBLIC_ANALYTICS_SINK_URL=http://127.0.0.1:28765

# Android Emulator (доступ к localhost хоста):
# EXPO_PUBLIC_ANALYTICS_SINK_URL=http://10.0.2.2:28765

# Физическое устройство — LAN-IP компьютера:
# EXPO_PUBLIC_ANALYTICS_SINK_URL=http://192.168.1.x:28765

# ── Feature flags ─────────────────────────────────────────────────────────────

# Отключить bootstrap grant-sync без нового релиза (например, перед миграцией БД).
# Зеркало серверного GRANT_SYNC_ENABLED. По умолчанию включено.
# EXPO_PUBLIC_GRANT_SYNC_ENABLED=false
