# /etc/cosmo-backup.env — скопировать и заполнить на сервере
# chmod 600 /etc/cosmo-backup.env

PG_CONTAINER=cosmo-postgres
PG_DB=cosmo_db
PG_USER=postgres
BACKUP_DIR=/var/backups/cosmo/daily
KEEP_DAYS=7

# S3 (опционально — для --remote)
BACKUP_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID и AWS_SECRET_ACCESS_KEY — через aws configure или IAM role
