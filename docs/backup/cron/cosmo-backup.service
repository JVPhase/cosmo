# systemd service unit для backup (альтернатива cron)
# Установка:
#   sudo cp cosmo-backup.service /etc/systemd/system/
#   sudo cp cosmo-backup.timer  /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cosmo-backup.timer

[Unit]
Description=Cosmo PostgreSQL Backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/cosmo-backup.env
ExecStart=/opt/cosmo/docs/backup/scripts/backup.sh --remote
ExecStartPost=/opt/cosmo/docs/backup/scripts/verify-backup.sh
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cosmo-backup
