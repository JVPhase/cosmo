{
  "name": "cosmo-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:test:setup": "tsx scripts/test-db-setup.ts",
    "test:contract": "tsx --env-file=.env.test --test test/contract/*.test.ts",
    "test:contract:verbose": "tsx --env-file=.env.test --test --test-reporter=spec test/contract/*.test.ts"
  },
  "prisma": {
    "seed": "prisma generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "@cosmo/game-config": "file:../packages/game-config",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.43.0",
    "jose": "^5.0.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2"
  }
}
