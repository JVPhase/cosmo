# PostgreSQL connection string (Prisma)
# Local Docker (docker compose in repo root): npm run db:up — then use URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cosmo_db"

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET="replace_me_with_a_long_random_string"

# ── OAuth ─────────────────────────────────────────────────────────────────────

# Google: comma-separated OAuth client IDs (iOS, Android, Web).
GOOGLE_CLIENT_IDS="ios_client_id.apps.googleusercontent.com,android_client_id.apps.googleusercontent.com"

# Apple: your app's bundle ID (= the `aud` claim Apple puts in ID tokens).
APPLE_BUNDLE_ID="com.yourcompany.cosmo-miner"

# ── Telegram Mini App ─────────────────────────────────────────────────────────

# TODO: Replace with your real Telegram bot token from @BotFather
# Create bot: https://t.me/BotFather → /newbot
# Required for: initData validation, Stars invoice creation
TELEGRAM_BOT_TOKEN="1234567890:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# TODO: Shared secret for webhook signature verification.
# Set this when registering the webhook:
#   POST https://api.telegram.org/bot<TOKEN>/setWebhook
#   { "url": "https://your-server.com/telegram/webhook", "secret_token": "<this value>" }
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="replace_me_with_random_secret"

# Optional: set to "false" to disable Stars payments globally
MONETIZATION_ENABLED=true

# ── Feature flags (all default to enabled when unset) ─────────────────────────

# Reject V2 save envelopes — rollback path if V2 client is causing issues.
# SAVE_V2_ENABLED=false

# Disable grant-sync API (GET /sync/grants, POST /sync/grants/ack).
# Use before applying Grant/Inventory DB migration to drain traffic safely.
# GRANT_SYNC_ENABLED=false

# Restrict shop catalog and invoice endpoint to grant_sync items only.
# Set to "false" to expose all active shop items (e.g. when premium_unlock is ready).
# TELEGRAM_SHOP_SYNC_ONLY=false

# Optional: override defaults
# NODE_ENV=development
