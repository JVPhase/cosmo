generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  // Nullable: Telegram-only users have no email; email+password accounts always set it
  email         String?        @unique
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  save          UserSave?
  gameplaySave  GameplaySave?
  wallet        Wallet?
  oauthAccounts OAuthAccount[]
  telegramUser  TelegramUser?
  purchases     Purchase[]
  inventory     Inventory[]
  grants        Grant[]
  crmUser       CrmUser?
  crmAccounts   CrmAccount[]
  crmLeads      CrmLead[]
  crmDeals      CrmDeal[]
  crmActivities CrmActivity[]
}

model TelegramUser {
  id           String   @id @default(cuid())
  telegramId   BigInt   @unique
  firstName    String
  lastName     String?
  username     String?
  photoUrl     String?
  languageCode String?
  isPremium    Boolean  @default(false)
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // "google" | "apple"
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserSave {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  rev       Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ── P1: Segregated gameplay save ──────────────────────────────────────────────
// Stores GameplaySaveEnvelopeV2 JSON. Mobile is the sole writer.
// Supersedes UserSave; dual-read during SAVE_TABLE_V2_ENABLED migration window.
model GameplaySave {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     // GameplaySaveEnvelopeV2
  rev       Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── P1: Wallet ────────────────────────────────────────────────────────────────
// Server-authoritative credit counter for atomic operations.
// Populated via backfill from UserSave/GameplaySave.credits.
// Activated when WALLET_ENABLED=true; credits remain in save JSON until then.
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits   BigInt   @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
}

model GameConfig {
  key       String   @id
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ── Shop ──────────────────────────────────────────────────────────────────────

// Canonical shop catalog. Items are seeded from @cosmo/game-config SHOP_DATA
// plus any Stars-priced items defined here.
model ShopItem {
  id           String     @id // matches game-config item id, e.g. "booster_mining_1h"
  type         String // "booster" | "metal_pack" | "loot_box" | "skin" | "bundle" | "premium_unlock"
  name         String
  description  String
  priceStars   Int? // Telegram Stars price (null = not purchaseable with Stars)
  priceCredits Int? // In-game credits price (null = not purchaseable with credits)
  metadata     Json // Item-specific payload delivered on purchase
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  purchases    Purchase[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Tracks every purchase attempt and its lifecycle.
model Purchase {
  id                      String    @id @default(cuid())
  userId                  String
  shopItemId              String
  paymentMethod           String // "stars" | "credits"
  // Telegram's unique payment charge ID — used for idempotency
  telegramPaymentChargeId String?   @unique
  starsAmount             Int?
  creditsAmount           Int?
  // pending → completed | failed | refunded
  status                  String    @default("pending")
  fulfilledAt             DateTime?
  // Any extra context (e.g. invoice nonce for Stars flow)
  metadata                Json?
  user                    User      @relation(fields: [userId], references: [id])
  shopItem                ShopItem  @relation(fields: [shopItemId], references: [id])
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@index([telegramPaymentChargeId])
}

// ── Grants ────────────────────────────────────────────────────────────────────

// Server-to-mobile delivery channel for purchase effects.
// mobile applies grants in seq order, then acks upToSeq.
// ackedAt = null means grant is pending delivery.
model Grant {
  id         String    @id @default(cuid())
  userId     String
  seq        Int
  kind       String    // "credits_grant" | "metal_grant" | "booster_grant" | "loot_box_reward_grant"
  payload    Json      // deterministic reward payload, no rolling on client
  source     String?   // e.g. "purchase"
  purchaseId String?
  ackedAt    DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seq])
  @@index([userId, ackedAt, seq])
}

// Server-authoritative inventory for each user.
// itemId matches game-config IDs (e.g. "booster_mining_1h", "metal_iron").
model Inventory {
  id        String    @id @default(cuid())
  userId    String
  itemType  String // "booster" | "metal_pack" | "loot_box" | "skin" | "premium_unlock"
  itemId    String // matches ShopItem.id / game-config id
  quantity  Int       @default(1)
  // For time-limited items: expiry, effect metadata, consume state, etc.
  metadata  Json?
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
}

// ────────────────────────────── CRM ──────────────────────────────
model CrmUser {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      String   @default("member") // "admin" | "member" | "viewer"
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmAccount {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  region    String?
  status    String   @default("Active")
  health    String   @default("Stable")
  arr       Int?
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  deals     CrmDeal[]
  activities CrmActivity[]
  convertedLeads CrmLead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model CrmLead {
  id                 String   @id @default(cuid())
  name               String
  email              String?
  company            String?
  source             String?
  status             String   @default("New")
  score              Int?
  ownerId            String?
  owner              User?    @relation(fields: [ownerId], references: [id])
  convertedAccountId String?
  convertedAccount   CrmAccount? @relation(fields: [convertedAccountId], references: [id])
  activities         CrmActivity[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model CrmDeal {
  id        String   @id @default(cuid())
  name      String
  stage     String   @default("Qualified")
  value     Int?
  closeDate DateTime?
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  accountId String?
  account   CrmAccount? @relation(fields: [accountId], references: [id])
  activities CrmActivity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([accountId])
  @@index([stage])
}

model CrmActivity {
  id        String   @id @default(cuid())
  type      String   @default("Note")
  title     String
  notes     String?
  dueAt     DateTime?
  doneAt    DateTime?
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  accountId String?
  account   CrmAccount? @relation(fields: [accountId], references: [id])
  leadId    String?
  lead      CrmLead? @relation(fields: [leadId], references: [id])
  dealId    String?
  deal      CrmDeal? @relation(fields: [dealId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([accountId])
  @@index([leadId])
  @@index([dealId])
}
